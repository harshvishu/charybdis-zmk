#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NUM 1
#define SYM 2
#define FUNC 3
#define GAME 4
#define PTR 5
#define SCRL 6
#define SNIP 7

&sl { release-after-ms = <250>; };

/ {
    #include "combos.dtsi"

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3          &kp N4   &kp N5         &kp N6      &kp N7           &kp N8     &kp N9   &kp N0     &kp BSPC
&kp TAB         &kp Q   &kp W   &kp E           &kp R    &kp T          &kp Y       &kp U            &kp I      &kp O    &kp P      &kp BACKSLASH
&kp LSHIFT      &kp A   &kp S   &kp D           &kp F    &kp G          &kp H       &kp J            &kp K      &kp L    &kp SEMI   &kp APOS
&kp LCTRL       &kp Z   &kp X   &kp C           &kp V    &kp B          &kp N       &kp M            &kp COMMA  &kp DOT  &kp SLASH  &kp GRAVE
                                &kp LGUI        &kp SPACE  &mo NUM  &mo SYM     &kp ENTER
                                                &mo PTR   &kp LALT  &kp RALT
            >;
        };

        Num {
            label = "Num";
            bindings = <
&trans  &kp N7  &kp N8   &kp N9     &kp SLASH  &kp BSPC   &kp F1  &kp F2  &kp F3     &kp F4    &kp F5  &kp F6
&trans  &kp N4  &kp N5   &kp N6     &kp ASTRK  &kp EQUAL  &kp F7  &kp F8  &kp F9     &kp F10   &kp F11 &kp F12
&trans  &kp N1  &kp N2   &kp N3     &kp MINUS  &kp COMMA  &none   &none   &none       &none     &none   &trans
&trans  &kp N0  &kp DOT  &kp ENTER  &kp PLUS   &kp DEL    &none   &none   &none       &none     &none   &trans
                            &trans    &trans      &trans     &mo FUNC  &trans
                                      &trans      &trans     &trans
            >;
        };

        Sym {
            label = "Sym";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR      &kp PRCNT  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR       &trans
&trans  &kp GRAVE  &kp TILDE  &kp LT    &kp GT        &kp QMARK  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BACKSLASH  &trans
&trans  &kp SEMI   &kp COLON  &kp APOS  &kp DQT       &kp SLASH  &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE       &trans
&trans  &none      &none      &none     &kp BACKSPACE &kp DEL    &none      &none      &trans     &trans    &trans         &trans
                               &trans    &mo FUNC      &trans      &trans     &trans
                                         &trans        &trans      &trans
            >;
        };

        Func {
            label = "Func";
            bindings = <
&trans           &trans      &trans             &trans        &trans  &trans      &trans        &trans        &trans        &trans          &trans   &rgb_ug RGB_EFF
&trans           &kp F1      &kp F2             &kp F3        &kp F4  &kp F5      &kp F6        &none         &none          &none           &none     &rgb_ug RGB_BRI
&rgb_ug RGB_TOG  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &trans  &kp CAPS    &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &trans          &none     &rgb_ug RGB_BRD
&trans           &trans      &trans             &trans        &trans  &to GAME    &out OUT_USB  &trans        &trans        &trans          &none     &trans
                                                &trans        &trans  &trans      &trans        &studio_unlock
                                                              &trans  &trans      &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
&trans  &trans  &trans  &trans     &trans    &trans    &trans    &trans     &trans    &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans    &trans    &trans    &trans     &kp UP    &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans    &trans    &trans    &kp LEFT   &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans     &trans    &trans    &trans    &trans     &trans    &trans     &trans  &trans
                        &kp SPACE  &to BASE  &trans    &to BASE  &kp ENTER
                                   &trans    &trans    &trans
            >;
        };

        Ptr {
            label = "Pointer";
            bindings = <
&none  &trans    &trans    &trans    &trans     &trans  &trans  &trans     &trans    &trans     &trans  &none
&none  &trans    &trans    &mkp MCLK  &trans     &trans  &trans  &trans     &mkp MCLK  &trans     &trans  &none
&kp LSHIFT  &trans    &mkp RCLK  &kp UP    &mkp LCLK  &trans  &trans  &mkp LCLK  &kp UP     &mkp RCLK  &trans  &none
&kp LCTRL   &mo SCRL  &kp LEFT   &kp DOWN  &kp RIGHT  &trans  &trans  &kp LEFT   &kp DOWN   &kp RIGHT  &trans  &none
                            &trans  &trans  &trans  &trans   &trans
                                    &trans  &trans  &trans
            >;
        };

        Scroll {
            label = "Scroll";
            bindings = <
&none  &trans  &trans    &trans    &trans     &trans  &trans  &trans          &trans          &trans           &trans  &none
&none  &trans  &trans    &trans    &trans     &trans  &trans  &trans          &trans          &trans           &trans  &none
&trans  &trans  &trans    &kp UP    &trans     &trans  &trans  &trans          &msc SCRL_UP    &trans           &trans  &none
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &none
                          &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans  &trans
            >;
        };

        Snipe {
            label = "Snipe";
            bindings = <
&none  &trans  &trans    &trans    &trans     &trans  &trans  &trans    &trans    &trans     &trans  &none
&none  &trans  &trans    &trans    &trans     &trans  &trans  &trans    &trans    &trans     &trans  &none
&trans  &trans  &trans    &kp UP    &trans     &trans  &trans  &trans    &kp UP    &trans     &trans  &none
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &none
                        &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans
            >;
        };
    };
};
